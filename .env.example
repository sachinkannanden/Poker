# Copy to .env and fill in. Leave blank to run without saving history.
# Supabase: Project Settings → API. Use the *service role* key; it stays on the server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Only for the split deployment:
# Server: the Vercel site that may connect, e.g. https://holdem-night.vercel.app
CLIENT_ORIGIN=
# Frontend build (set in Vercel project settings): the realtime server's public URL
# VITE_SERVER_URL=https://holdem-server.onrender.com
