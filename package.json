{
  "name": "holdem-table",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Same-room Texas Hold'em table manager: digital or physical cards, phones as seats.",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"node --watch server/index.js\" \"vite --config client/vite.config.js\"",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "test": "node --test server/*.test.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@vitejs/plugin-react": "^6.1.2",
    "express": "^4.22.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
